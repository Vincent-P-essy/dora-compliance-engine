# ─── dora-compliance-engine — environment configuration ──────────────────────
# Copy to `.env` and adjust. Docker Compose reads this file automatically.
# NEVER commit the real `.env` (it is gitignored).

# ── Flask / API ───────────────────────────────────────────────────────────────
# Secret used to sign Flask sessions. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Secret used to sign JWT access tokens. MUST be different from SECRET_KEY.
JWT_SECRET_KEY=change-me-too-in-production

# JWT access-token lifetime, in seconds (default: 1 hour).
JWT_ACCESS_TOKEN_EXPIRES=3600

# Port the API listens on (used by docker-compose port mapping).
API_PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
# SQLAlchemy connection URL. The default targets the docker-compose `db` service.
# For a local run without Docker you can use: sqlite:///dora.db
DATABASE_URL=postgresql+psycopg://dora:dora-local-password@db:5432/dora

# Credentials consumed by the postgres container (must match DATABASE_URL).
POSTGRES_USER=dora
POSTGRES_PASSWORD=dora-local-password
POSTGRES_DB=dora

# ── Policy engine (OPA) ───────────────────────────────────────────────────────
# Path to the OPA binary. Leave empty to look it up on $PATH.
# The Docker image bundles OPA at /usr/local/bin/opa.
OPA_PATH=

# Directory containing the Rego policy bundle.
POLICIES_DIR=engine/policies

# ── Drift detection ───────────────────────────────────────────────────────────
# A drift alert fires when the score drops by more than this many points…
DRIFT_THRESHOLD=5
# …compared to the baseline snapshot taken this many days ago.
DRIFT_BASELINE_DAYS=7

# ── CI/CD gate ────────────────────────────────────────────────────────────────
# Default minimum score when POST /api/gate/check omits `minimum_score`.
GATE_DEFAULT_MIN_SCORE=75

# ── Demo users (created by `flask seed-demo`) ─────────────────────────────────
# Passwords are hashed (scrypt) before storage; plaintext lives only here.
DEMO_CISO_PASSWORD=ciso-demo-password
DEMO_DEVOPS_PASSWORD=devops-demo-password
DEMO_AUDITOR_PASSWORD=auditor-demo-password
